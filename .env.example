# Copy to .env and fill in, or export these in your shell. Placeholders only: never commit real values.
# With nothing set, Palace runs offline on the synthetic demo palace and makes no model calls (preview mode).

# Meterless Nightshift: the primary AI provider (Nemotron via Nightshift's NVIDIA provider)
METERLESS_BASE_URL=http://127.0.0.1:8088
METERLESS_API_KEY=your-nightshift-runtime-token

# Or Nebius Token Factory (used when METERLESS_BASE_URL is unset, or with PALACE_PROVIDER=tokenfactory)
NEBIUS_API_KEY=your-token-factory-key

# Zetaris: the organisation's records (load them once with demo/zetaris/load_zetaris.py)
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_EMAIL=you@example.com
ZETARIS_PASSWORD=your-zetaris-password
# or an API token instead of a login:
# ZETARIS_TOKEN=...
# ZETARIS_ORG_ID=1

# Optional: append H-MEM's trust ledger to a file
# PALACE_TRUST_LEDGER=logs/trust-ledger.jsonl
